{
  "expo": {
    "name": "Reflexion Mirror",
    "owner": "reflexionsg",
    "slug": "reflexion-mobile-mirror-interface-app",
    "version": "1.0.2",
    "updates": {
      "url": "https://u.expo.dev/f765e920-7d0f-4f73-bdd0-cf2990390bc0",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "main"
      }
    },
    "runtimeVersion": "1.0.3",
    "orientation": "portrait",
    "scheme": "reflexionmirror",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "barStyle": "dark-content",
      "translucent": false
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Reflexion uses the camera only for diagnostics or future consented features. Daily voice check-ins do not use it.",
        "NSMicrophoneUsageDescription": "Reflexion uses the microphone for realtime AI conversations."
      }
    },
    "android": {
      "package": "com.reflexion.mirror",
      "versionCode": 4,
      "allowBackup": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-camera",
      "expo-audio",
      "onnxruntime-react-native",
      "expo-asset",
      "@config-plugins/react-native-webrtc",
      "./plugins/withKioskAndroid",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f765e920-7d0f-4f73-bdd0-cf2990390bc0"
      }
    }
  }
}
